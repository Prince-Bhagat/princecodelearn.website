---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import ImageContainer from "../../elements/ImageContainer.astro";

// assets
import prince_pic from "../../../assets/images/peter2.jpg";

---

<Container variant={'xl'}>
    <Heading tagName="h1" tagSize="h1" class="text-center">Meet Prince</Heading>
    <div class="flex md:flex-row flex-col gap-16 md:items-center">
        <div class="flex-1 flex flex-col gap-7">
            <Text variant={'xl'} class="text-base-900">I'm a Software Engineer passionate about crafting scalable solutions that connect businesses with their goals through thoughtful development and strategic thinking.</Text>
            <Text variant={'sm'} class="text-base-900">For the past 5 years, I've been helping companies solve complex challenges through software. I believe great software isn't just about writing code—it's about understanding requirements, solving problems, and creating meaningful impact.</Text>
        </div>
        <div class="flex-1 md:h-[700px] w-full">
            <ImageContainer src={prince_pic} alt="Prince"/>
        </div>
    </div>
</Container>