---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import ResumeDropdown from "../../elements/ResumeDropdown.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";

// content
const experience = [
    { 
        title: "Product Developer I",
        place: "BMC Software",
        period: "06/2024 - Present",
        text: "Work on BMC AMI zAdviser, enhancing software delivery via contextual data capture. Uses DORA metrics and mainframe KPIs for insights, enabling performance benchmarking and development efficiency boost through AI recommendations. Lead for Jira Integration."
    },
    { 
        title: "Software Engineer",
        place: "RIA Insurance",
        period: "07/2022 - 05/2024",
        text: "Contributed to cloud-based microservices architecture and low-code insurance workflow automation using Camunda. Created reusable BPMN workflows, optimized APIs with 20% performance improvement, established testing framework reducing bugs by 40%."
    },
    { 
        title: "Software Engineering Intern",
        place: "RIA Insurance",
        period: "06/2021 - 06/2022",
        text: "Developed high-performance APIs for customer data, implemented Spring Boot microservices, participated in Agile processes, orchestrated business workflows using Camunda."
    },
]
---

<Container variant={'md'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">Experience</Heading>
    <div class="flex flex-col gap-4">  
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {
                experience.map((i) => (
                    <ResumeDropdown title={i.title} place={i.place} period={i.period} text={i.text} />
                ))
            }
        </Container>
        <ContainerBottom />
    </div>

</Container>
