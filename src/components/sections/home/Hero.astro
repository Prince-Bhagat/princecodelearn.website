---
// components
import Container from "../../elements/Container.astro"
import Text from "../../elements/Text.astro"
import Heading from "../../elements/Heading.astro"
import ImageContainer from "../../elements/ImageContainer.astro"
import Link from "../../elements/Link.astro"

// assets
import prince_main from "../../../assets/images/prince_main.jpg";
---

<Container variant={"xl"} class="flex flex-col gap-8 min-h-screen">
    <Text variant={'xl'} class="text-base-900 lg:max-w-1/3 md:max-w-1/2 w-full">Hey there! I'm a Software Engineer with 5 years of experience delivering high-quality, scalable solutions using Java, Camunda, Spring Boot, and NodeJS.</Text>
    <Container class="flex md:flex-row flex-col gap-8">
        <Container class="md:flex-2 flex flex-col items-start gap-4">
            <Link variant={'button'} href="/contact">Available for work</Link>
            <Heading tagName="h1" tagSize="h1">Prince Bhagat</Heading>
        </Container>
        <Container class="h-full md:h-[600px] flex-1">
            <ImageContainer src={prince_main} alt="Prince Bhagat" />
        </Container>
    </Container>
</Container>

